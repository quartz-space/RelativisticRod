<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RelativisticRod.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="Relativistic Rod Deformation">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" RowDefinitions="Auto,*">
        <Grid.Resources>
            <ResourceDictionary>
                <Style x:Key="CardStyle" TargetType="Border">
                    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                    <Setter Property="Padding" Value="16" />
                </Style>

                <Style x:Key="MonoValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                </Style>

                <Style x:Key="ReadoutLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                </Style>

                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="TrueSeriesBrush" Color="#2575FC" />
                        <SolidColorBrush x:Key="SeenSeriesBrush" Color="#C84288" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="TrueSeriesBrush" Color="#6AA2FF" />
                        <SolidColorBrush x:Key="SeenSeriesBrush" Color="#FF6FB6" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <!-- Custom title bar (Mica shows through) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Padding="16,0,0,0">
            <TextBlock Text="Relativistic Rod Deformation"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="920" Padding="24,8,24,24" Spacing="12">

                <!-- Header -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Apparent relativistic rod deformation"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="{ThemeResource TrueSeriesBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="True" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="{ThemeResource SeenSeriesBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Apparent" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Compare a swung rod's instantaneous physical curve with its time-delayed image seen by an observer." />
                    </StackPanel>
                </Border>

                <!-- Simulation viewport -->
                <Border Style="{StaticResource CardStyle}" Padding="0" Height="380">
                    <Grid>
                        <canvas:CanvasAnimatedControl
                            x:Name="RodCanvas"
                            ClearColor="Transparent"
                            IsFixedTimeStep="False"
                            IsTabStop="True"
                            UseSystemFocusVisuals="True"
                            AutomationProperties.Name="Interactive simulation of the true versus apparent shape of a swinging rod. Move the pointer over the rod, or use the up and down arrow keys, to inspect a segment."
                            Update="Canvas_Update"
                            Draw="Canvas_Draw"
                            PointerMoved="RodCanvas_Pointer"
                            PointerPressed="RodCanvas_PointerPressed"
                            KeyDown="RodCanvas_KeyDown" />

                        <Grid IsHitTestVisible="False" Margin="12" VerticalAlignment="Top" ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0"
                                    Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" Opacity="0.9"
                                    CornerRadius="14" Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="{ThemeResource TrueSeriesBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Physical state (t)" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2"
                                    Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" Opacity="0.9"
                                    CornerRadius="14" Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="{ThemeResource SeenSeriesBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Retarded light state" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Inspection readout -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Rod segment (s)" Style="{StaticResource ReadoutLabelStyle}" />
                            <TextBlock x:Name="SegmentText" Text="50% L" Style="{StaticResource MonoValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Signal delay (Δt)" Style="{StaticResource ReadoutLabelStyle}" />
                            <TextBlock x:Name="DelayText" Text="0.00 s" Style="{StaticResource MonoValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="Spatial lag (Δr)" Style="{StaticResource ReadoutLabelStyle}" />
                            <TextBlock x:Name="LagText" Text="0.0 units" Style="{StaticResource MonoValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock Text="Apparent angle" Style="{StaticResource ReadoutLabelStyle}" />
                            <TextBlock x:Name="AngleText" Text="0.0°" Style="{StaticResource MonoValueStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Controls -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="12" ColumnSpacing="12"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnDefinitions="160,*,64">

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Wave speed (v)" VerticalAlignment="Center" />
                        <Slider x:Name="VWaveSlider" Grid.Row="0" Grid.Column="1"
                                Minimum="0.10" Maximum="0.80" StepFrequency="0.01" SmallChange="0.01" LargeChange="0.05"
                                Value="0.25" IsThumbToolTipEnabled="False"
                                AutomationProperties.Name="Wave propagation speed"
                                ValueChanged="Slider_ValueChanged" />
                        <TextBlock x:Name="VWaveValue" Grid.Row="0" Grid.Column="2" Text="0.25"
                                   Style="{StaticResource MonoValueStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Swing rate (f)" VerticalAlignment="Center" />
                        <Slider x:Name="FreqSlider" Grid.Row="1" Grid.Column="1"
                                Minimum="0.10" Maximum="1.50" StepFrequency="0.05" SmallChange="0.05" LargeChange="0.1"
                                Value="0.60" IsThumbToolTipEnabled="False"
                                AutomationProperties.Name="Swing frequency"
                                ValueChanged="Slider_ValueChanged" />
                        <TextBlock x:Name="FreqValue" Grid.Row="1" Grid.Column="2" Text="0.60 Hz"
                                   Style="{StaticResource MonoValueStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Observer distance (y)" VerticalAlignment="Center" />
                        <Slider x:Name="ObsSlider" Grid.Row="2" Grid.Column="1"
                                Minimum="-60" Maximum="-10" StepFrequency="1" SmallChange="1" LargeChange="5"
                                Value="-25" IsThumbToolTipEnabled="False"
                                AutomationProperties.Name="Observer Y distance"
                                ValueChanged="Slider_ValueChanged" />
                        <TextBlock x:Name="ObsValue" Grid.Row="2" Grid.Column="2" Text="-25"
                                   Style="{StaticResource MonoValueStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                        <Grid Grid.Row="3" Grid.ColumnSpan="3" ColumnDefinitions="Auto,*">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="PlayPauseButton" Click="PlayPause_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon x:Name="PlayIcon" Glyph="&#xE769;" FontSize="14" />
                                        <TextBlock x:Name="PlayLabel" Text="Pause" />
                                    </StackPanel>
                                </Button>
                                <ToggleButton x:Name="PhotonsToggle" Content="Photons" IsChecked="True"
                                              Click="Photons_Click" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="c = 1.0 (lightspeed)"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
